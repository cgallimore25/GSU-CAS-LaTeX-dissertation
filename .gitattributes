# Default to LF line endings
* text=auto eol=lf

# Denote all files that are truly binary and should not be modified.
# Raster images
*.png  binary
*.PNG  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.tif  binary
*.tiff binary
*.bmp  binary
*.webp binary
*.psd  binary

# Video/Audio
*.mp4  binary
*.mov  binary
*.mp3  binary
*.wav  binary

# Fonts
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary

# Documents/Archives
*.pdf  binary
*.zip  binary
*.tar.gz binary
*.7z   binary
*.db   binary
*.sqlite binary